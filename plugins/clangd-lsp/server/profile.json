{
  "name": "clangd",
  "command": "clangd",
  "args": [
    "--background-index"
  ],
  "autoInstall": "clangd-installer.mjs",
  "extensionToLanguage": {
    ".c": "c",
    ".h": "c",
    ".cpp": "cpp",
    ".cc": "cpp",
    ".cxx": "cpp",
    ".hpp": "cpp",
    ".hxx": "cpp",
    ".C": "cpp",
    ".H": "cpp"
  },
  "rootMarkers": [
    "compile_commands.json",
    "compile_flags.txt",
    ".clangd",
    "CMakeLists.txt",
    "meson.build"
  ],
  "install": "Automatic installation covers x64 Windows, macOS and Linux; elsewhere install LLVM or your distribution's clangd package."
}
