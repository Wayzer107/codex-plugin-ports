{
  "name": "clangd",
  "command": "clangd",
  "autoInstall": true,
  "args": [
    "--background-index"
  ],
  "extensionToLanguage": {
    ".c": "c",
    ".h": "c",
    ".cpp": "cpp",
    ".cc": "cpp",
    ".cxx": "cpp",
    ".hpp": "cpp",
    ".hxx": "cpp",
    ".C": "cpp",
    ".H": "cpp"
  }
}
